    "_postman_id": "f856acf5-8e55-4ce2-bd50-e0d69b8efd24",
    "name": "Cumulocity Alarm Alarms Asset Models API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Raise, query, acknowledge, clear, and bulk-update alarms with four severity levels (CRITICAL, MAJOR,\nMINOR, WARNING) and four statuses (ACTIVE, ACKNOWLEDGED, CLEARED). Cumulocity auto-deduplicates alarms\nby source + type so repeated raises increment the count rather than creating duplicates.\n",
      "type": "text/plain"
    }
  }
