{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cumulocity Alarm Alarms Cloud Sync API",
    "version": "10.20.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cloud Sync",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Cloud Sync Configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.cumulocity.com/service/edge/cloud-sync"
          },
          "docs": "Retrieve Cloud Sync Configuration"
        },
        {
          "info": {
            "name": "Update Cloud Sync Configuration",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{tenant}.cumulocity.com/service/edge/cloud-sync",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Cloud Sync Configuration"
        }
      ]
    }
  ],
  "bundled": true
}